// =====================================================================================
// 0001 — users, auth, vendors, reference data, settings, audit, jobs
// =====================================================================================

model User {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  /// E.164, +9665XXXXXXXX only (D23, CHECK in SQL). Required for customers; staff may log in by email.
  phone                 String?    @unique
  phoneVerifiedAt       DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  email                 String?    @unique @db.Citext
  emailVerifiedAt       DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// scrypt hash (src/lib/auth/password.ts). Omitted globally.
  passwordHash          String?    @map("password_hash")
  role                  Role       @default(CUSTOMER)
  /// STAFF permissions (SPEC §4). Vendor staff permissions live in VendorMember.
  permissions           String[]   @default([])
  status                UserStatus @default(ACTIVE)
  locale                AppLocale  @default(ar)
  lastLoginAt           DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// D22: negotiation suspended (contact-sharing attempts, admin action).
  bargainSuspendedUntil DateTime?  @map("bargain_suspended_until") @db.Timestamptz(3)
  /// M10: account deletion = anonymisation; orders/invoices keep their snapshots.
  deletedAt             DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  trustedDevices    TrustedDevice[]
  consents          MarketingConsent[]
  vendorsOwned      Vendor[]           @relation("VendorOwner")
  vendorMemberships VendorMember[]
  addresses         Address[]
  wishlist          Wishlist[]
  carts             Cart[]
  orders            Order[]
  reviews           Review[]
  returns           Return[]
  notifications     Notification[]
  priceRequests     PriceRequest[]
  priceLocks        PriceLock[]
  dealRedemptions   DealRedemption[]

  @@index([role, status])
  @@map("users")
}

/// Server-side session (SPEC §2 "جلسات من السيرفر"). The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  userId              String    @map("user_id") @db.Uuid
  /// Vendor context chosen at login (VENDOR_OWNER / VENDOR_STAFF). vendorId for queries ALWAYS comes from here.
  vendorId            String?   @map("vendor_id") @db.Uuid
  /// D31: when staffTwoFactorEnabled, a staff session is usable only after the second factor.
  twoFactorPending    Boolean   @default(false) @map("two_factor_pending")
  twoFactorVerifiedAt DateTime? @map("two_factor_verified_at") @db.Timestamptz(3)
  ip                  String?
  userAgent           String?   @map("user_agent")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Self-generated OTP (D20, SPEC §9): 6 digits, HMAC-SHA256 only, 5 minutes, 5 attempts then locked.
model OtpChallenge {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String
  purpose     OtpPurpose
  userId      String?    @map("user_id") @db.Uuid
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  lockedAt    DateTime?  @map("locked_at") @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("otp_challenges")
}

/// D31: "تذكر هذا الجهاز 30 يوماً" for staff 2FA. Cookie token, SHA-256 stored.
model TrustedDevice {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_devices")
}

/// Fixed-window counters in Postgres (portable, no Redis — D12). Key examples: otp:phone:+9665..., otp:ip:1.2.3.4.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

/// SPEC §8 / PDPL: unticked box, record who, when, version. Append-only history (latest row wins).
model MarketingConsent {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  channel   ConsentChannel
  granted   Boolean
  version   String
  source    String
  ip        String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, createdAt(sort: Desc)])
  @@map("marketing_consents")
}

/// M4 / D23.
model City {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr     String   @map("name_ar")
  nameEn     String   @map("name_en")
  slug       String   @unique
  regionCode String?  @map("region_code")
  isActive   Boolean  @default(true) @map("is_active")
  sort       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendors       Vendor[]
  addresses     Address[]
  zones         ShippingZoneCity[]
  priceRequests PriceRequest[]

  @@map("cities")
}

model Category {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  nameAr         String   @map("name_ar")
  nameEn         String   @map("name_en")
  slug           String   @unique
  imagePath      String?  @map("image_path")
  sort           Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  /// bps, overrides Setting.defaultCommission (SPEC 6.1 priority chain).
  commissionRate Int?     @map("commission_rate")
  showOnHome     Boolean  @default(false) @map("show_on_home")
  homeSort       Int      @default(0) @map("home_sort")
  /// D26: false = platform products only (swords until the owner decides, O11).
  vendorsAllowed Boolean  @default(true) @map("vendors_allowed")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent        Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]       @relation("CategoryTree")
  products      Product[]
  vendorLinks   VendorCategory[]
  priceRequests PriceRequest[]

  @@index([parentId, sort])
  @@map("categories")
}

model Vendor {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId           String       @map("owner_user_id") @db.Uuid
  storeNameAr           String       @map("store_name_ar")
  storeNameEn           String       @map("store_name_en")
  slug                  String       @unique
  logoPath              String?      @map("logo_path")
  coverPath             String?      @map("cover_path")
  descriptionAr         String?      @map("description_ar")
  descriptionEn         String?      @map("description_en")
  legalName             String       @map("legal_name")
  crNumber              String?      @map("cr_number")
  freelanceDocNumber    String?      @map("freelance_doc_number")
  vatNumber             String?      @map("vat_number")
  vatStatus             VatStatus    @default(NOT_REGISTERED) @map("vat_status")
  vatVerifiedAt         DateTime?    @map("vat_verified_at") @db.Timestamptz(3)
  /// O10 default: only residents at launch (allowNonResidentVendors = false).
  isResident            Boolean      @default(true) @map("is_resident")
  /// AES-256-GCM ciphertext "keyId:iv:tag:data" (SPEC §9, src/lib/crypto/field-encryption.ts). Omitted globally.
  iban                  String?
  /// Masked display only: SA****1234.
  ibanLast4             String?      @map("iban_last4")
  bankName              String?      @map("bank_name")
  accountHolderName     String?      @map("account_holder_name")
  cityId                String?      @map("city_id") @db.Uuid
  /// SPEC §5. VendorPickupLocation (H2) is pending with O4 (SPEC §15 S8).
  pickupAddress         Json?        @map("pickup_address")
  commissionRate        Int?         @map("commission_rate")
  isTrusted             Boolean      @default(false) @map("is_trusted")
  status                VendorStatus @default(PENDING)
  rejectReason          String?      @map("reject_reason")
  agreementAcceptedAt   DateTime?    @map("agreement_accepted_at") @db.Timestamptz(3)
  agreementVersion      String?      @map("agreement_version")
  shippingMode          ShippingMode @default(PLATFORM_SHIPPING) @map("shipping_mode")
  /// O3 default: 14 for new vendors, set on approval (newVendorHoldDays).
  holdDaysOverride      Int?         @map("hold_days_override")
  approvedAt            DateTime?    @map("approved_at") @db.Timestamptz(3)
  approvedByUserId      String?      @map("approved_by_user_id") @db.Uuid
  suspendedAt           DateTime?    @map("suspended_at") @db.Timestamptz(3)
  bargainSuspendedUntil DateTime?    @map("bargain_suspended_until") @db.Timestamptz(3)
  /// D21 badges, aggregated by a job.
  ratingAvg             Decimal      @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount           Int          @default(0) @map("rating_count")
  avgResponseMinutes    Int?         @map("avg_response_minutes")
  acceptanceRateBps     Int?         @map("acceptance_rate_bps")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner              User                    @relation("VendorOwner", fields: [ownerUserId], references: [id])
  city               City?                   @relation(fields: [cityId], references: [id])
  sessions           Session[]
  documents          VendorDocument[]
  members            VendorMember[]
  categories         VendorCategory[]
  bankChangeRequests VendorBankChangeRequest[]
  products           Product[]
  coupons            Coupon[]
  subOrders          SubOrder[]
  walletTransactions WalletTransaction[]
  payouts            Payout[]
  purchaseInvoices   VendorPurchaseInvoice[]
  deals              Deal[]
  recipients         PriceRequestRecipient[]
  threads            NegotiationThread[]
  offers             PriceOffer[]

  @@index([ownerUserId])
  @@index([status])
  @@map("vendors")
}

model VendorDocument {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId     String             @map("vendor_id") @db.Uuid
  type         VendorDocumentType
  /// M3: key in the PRIVATE bucket; links are presigned on demand.
  storagePath  String             @map("storage_path")
  status       ReviewDecision     @default(PENDING)
  reviewNote   String?            @map("review_note")
  reviewedById String?            @map("reviewed_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@map("vendor_documents")
}

model VendorMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// products.manage | orders.fulfill | finance.view | reviews.reply (SPEC §4)
  permissions String[] @default([])
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor Vendor @relation(fields: [vendorId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([vendorId, userId])
  @@index([userId])
  @@map("vendor_members")
}

/// D4: categories a vendor may sell in.
model VendorCategory {
  vendorId   String   @map("vendor_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([vendorId, categoryId])
  @@index([categoryId, vendorId])
  @@map("vendor_categories")
}

/// M2: IBAN changes need admin approval (SPEC 7.3).
model VendorBankChangeRequest {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId          String         @map("vendor_id") @db.Uuid
  /// ciphertext, same format as Vendor.iban
  iban              String
  ibanLast4         String         @map("iban_last4")
  bankName          String         @map("bank_name")
  accountHolderName String         @map("account_holder_name")
  letterDocumentId  String?        @map("letter_document_id") @db.Uuid
  status            ReviewDecision @default(PENDING)
  reviewedByUserId  String?        @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  reviewNote        String?        @map("review_note")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId, status])
  @@map("vendor_bank_change_requests")
}

/// Business settings (VAT, commission, O1/O3/O7 defaults, D22, D31...). Seeded by prisma/seed.ts.
model Setting {
  key             String   @id
  value           Json
  /// true = readable by the public storefront (whatsappNumber, pixels, storeInfo). Default private.
  isPublic        Boolean  @default(false) @map("is_public")
  description     String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// M11: append-only (trigger blocks UPDATE/DELETE).
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  vendorId    String?  @map("vendor_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model Redirect {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromPath  String   @unique @map("from_path")
  toPath    String   @map("to_path")
  code      Int      @default(301)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("redirects")
}

model Page {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  titleAr   String   @map("title_ar")
  titleEn   String   @map("title_en")
  contentAr String   @map("content_ar")
  contentEn String   @map("content_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("pages")
}

model Banner {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageDesktopPath String    @map("image_desktop_path")
  imageMobilePath  String    @map("image_mobile_path")
  link             String?
  titleAr          String?   @map("title_ar")
  titleEn          String?   @map("title_en")
  sort             Int       @default(0)
  isActive         Boolean   @default(true) @map("is_active")
  startsAt         DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sort])
  @@map("banners")
}

model HomeSection {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      HomeSectionType
  refId     String?         @map("ref_id") @db.Uuid
  sort      Int             @default(0)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sort])
  @@map("home_sections")
}

/// devops.md §6.5: leasing with FOR UPDATE SKIP LOCKED, heartbeat, idempotency.
model Job {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           String
  payload        Json      @default("{}")
  status         JobStatus @default(PENDING)
  runAt          DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  lastError      String?   @map("last_error")
  idempotencyKey String?   @unique @map("idempotency_key")
  lockedBy       String?   @map("locked_by")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  heartbeatAt    DateTime? @map("heartbeat_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([type, status])
  @@map("jobs")
}

// =====================================================================================
// 0002 — catalog, inventory
// =====================================================================================

model Product {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// D6: null = Souq AlZal itself (vendor zero).
  vendorId       String?       @map("vendor_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  nameAr         String        @map("name_ar")
  nameEn         String        @map("name_en")
  slug           String        @unique
  /// sanitized rich text (SPEC §9)
  descriptionAr  String?       @map("description_ar")
  descriptionEn  String?       @map("description_en")
  basePrice      Int           @map("base_price")
  compareAtPrice Int?          @map("compare_at_price")
  status         ProductStatus @default(DRAFT)
  rejectReason   String?       @map("reject_reason")
  isFeatured     Boolean       @default(false) @map("is_featured")
  weightGrams    Int           @default(0) @map("weight_grams")
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  /// Maintained by P2-01 (Arabic-normalised full text). GIN index in SQL.
  searchVector   Unsupported("tsvector")? @map("search_vector")
  ratingAvg      Decimal       @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount    Int           @default(0) @map("rating_count")
  soldCount      Int           @default(0) @map("sold_count")
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor              Vendor?              @relation(fields: [vendorId], references: [id])
  category            Category             @relation(fields: [categoryId], references: [id])
  images              ProductImage[]
  options             ProductOption[]
  variants            ProductVariant[]
  revisions           ProductRevision[]
  wishlistedBy        Wishlist[]
  reviews             Review[]
  deals               Deal[]
  negotiationSettings NegotiationSettings?
  priceRequests       PriceRequest[]
  threads             NegotiationThread[]
  offers              PriceOffer[]

  @@index([status, categoryId, createdAt(sort: Desc)])
  @@index([vendorId, status])
  @@map("products")
}

/// M5 / D23: edits to a published product of a non-trusted vendor; the published version stays visible.
model ProductRevision {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String         @map("product_id") @db.Uuid
  changes           Json
  status            RevisionStatus @default(PENDING)
  submittedByUserId String         @map("submitted_by_user_id") @db.Uuid
  reviewedByUserId  String?        @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  rejectReason      String?        @map("reject_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, status])
  @@index([status, createdAt])
  @@map("product_revisions")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// key in the PUBLIC bucket; URL built by StorageProvider.publicUrl()
  path      String
  alt       String?
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
  @@map("product_images")
}

model ProductOption {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid
  nameAr    String @map("name_ar")
  nameEn    String @map("name_en")
  sort      Int    @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  OptionValue[]

  @@index([productId, sort])
  @@map("product_options")
}

model OptionValue {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  optionId String @map("option_id") @db.Uuid
  valueAr  String @map("value_ar")
  valueEn  String @map("value_en")
  sort     Int    @default(0)

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId, sort])
  @@map("option_values")
}

model ProductVariant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String   @unique
  price          Int
  compareAtPrice Int?     @map("compare_at_price")
  /// CHECK stock >= 0, reserved_stock >= 0, reserved_stock <= stock (C3)
  stock          Int      @default(0)
  reservedStock  Int      @default(0) @map("reserved_stock")
  optionValueIds String[] @default([]) @map("option_value_ids") @db.Uuid
  weightGrams    Int?     @map("weight_grams")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product              Product                     @relation(fields: [productId], references: [id])
  reservations         StockReservation[]
  priceHistory         PriceHistory[]
  bundleItems          BundleItem[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  dealVariants         DealVariant[]
  negotiationSettings  VariantNegotiationSettings?
  priceRequests        PriceRequest[]
  threads              NegotiationThread[]
  offers               PriceOffer[]
  priceLocks           PriceLock[]

  @@index([productId])
  @@map("product_variants")
}

/// Bundles are platform-only in phase 1 (SPEC §5).
model Bundle {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr         String   @map("name_ar")
  nameEn         String   @map("name_en")
  slug           String   @unique
  price          Int
  compareAtPrice Int?     @map("compare_at_price")
  imagePath      String?  @map("image_path")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  items      BundleItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  deals      Deal[]

  @@map("bundles")
}

model BundleItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bundleId  String @map("bundle_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  qty       Int

  bundle  Bundle         @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([bundleId, variantId])
  @@index([variantId])
  @@map("bundle_items")
}

/// C3: every hold on stock (order checkout 30 min, PriceLock 24 h). Reserve = atomic conditional UPDATE.
model StockReservation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId   String            @map("variant_id") @db.Uuid
  qty         Int
  sourceType  ReservationSource @map("source_type")
  sourceId    String            @map("source_id") @db.Uuid
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?         @map("consumed_at") @db.Timestamptz(3)
  releasedAt  DateTime?         @map("released_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([sourceType, sourceId])
  @@index([variantId, status])
  @@map("stock_reservations")
}

model Wishlist {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlists")
}

// =====================================================================================
// 0003 — carts, addresses, coupons, orders, payments, returns, reviews, tax invoices
// =====================================================================================

model Address {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  label                String?
  recipientName        String   @map("recipient_name")
  recipientPhone       String   @map("recipient_phone")
  cityId               String   @map("city_id") @db.Uuid
  district             String
  street               String
  buildingNo           String?  @map("building_no")
  postalCode           String?  @map("postal_code")
  nationalAddressShort String?  @map("national_address_short")
  lat                  Decimal? @db.Decimal(9, 6)
  lng                  Decimal? @db.Decimal(9, 6)
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id])

  @@index([userId])
  @@map("addresses")
}

model Coupon {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// uppercase (CHECK)
  code                String               @unique
  type                CouponType
  /// PERCENT: bps (1000 = 10%); FIXED: halalas; FREE_SHIPPING: 0
  value               Int
  minOrder            Int?                 @map("min_order")
  maxDiscount         Int?                 @map("max_discount")
  /// null = public coupon carried by the platform (SPEC 6.1)
  vendorId            String?              @map("vendor_id") @db.Uuid
  appliesToCategoryIds String[]            @default([]) @map("applies_to_category_ids") @db.Uuid
  usageLimit          Int?                 @map("usage_limit")
  perUserLimit        Int?                 @map("per_user_limit")
  usedCount           Int                  @default(0) @map("used_count")
  startsAt            DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime             @map("ends_at") @db.Timestamptz(3)
  isActive            Boolean              @default(false) @map("is_active")
  approvalStatus      CouponApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  approvedByUserId    String?              @map("approved_by_user_id") @db.Uuid
  approvedAt          DateTime?            @map("approved_at") @db.Timestamptz(3)
  createdByUserId     String?              @map("created_by_user_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor Vendor? @relation(fields: [vendorId], references: [id])
  carts  Cart[]
  orders Order[]

  @@index([vendorId, isActive])
  @@map("coupons")
}

model Cart {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  /// SHA-256 of the guest cookie token (never the raw token)
  guestTokenHash String?   @unique @map("guest_token_hash")
  couponId       String?   @map("coupon_id") @db.Uuid
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId           String    @map("cart_id") @db.Uuid
  /// exactly one of variantId / bundleId (CHECK)
  variantId        String?   @map("variant_id") @db.Uuid
  bundleId         String?   @map("bundle_id") @db.Uuid
  qty              Int
  /// H8: FLASH price lock in cart (price only; quota reserved at checkout, D23)
  dealId           String?   @map("deal_id") @db.Uuid
  lockedUnitPrice  Int?      @map("locked_unit_price")
  priceLockedUntil DateTime? @map("price_locked_until") @db.Timestamptz(3)
  /// negotiation: item bought at a PriceLock price
  priceLockId      String?   @unique @map("price_lock_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  bundle    Bundle?         @relation(fields: [bundleId], references: [id])
  deal      Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  priceLock PriceLock?      @relation(fields: [priceLockId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// M1: SZ-100001 from a SEQUENCE
  number          String        @unique @default(dbgenerated("('SZ-'::text || nextval('order_number_seq'::regclass))"))
  userId          String        @map("user_id") @db.Uuid
  addressSnapshot Json          @map("address_snapshot")
  subtotal        Int
  discountTotal   Int           @default(0) @map("discount_total")
  shippingTotal   Int           @default(0) @map("shipping_total")
  vatTotal        Int           @map("vat_total")
  grandTotal      Int           @map("grand_total")
  vatRateBp       Int           @map("vat_rate_bp")
  couponId        String?       @map("coupon_id") @db.Uuid
  couponCode      String?       @map("coupon_code")
  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(INITIATED) @map("payment_status")
  status          OrderStatus   @default(PENDING_PAYMENT)
  buyerVatNumber  String?       @map("buyer_vat_number")
  buyerLegalName  String?       @map("buyer_legal_name")
  invoiceType     InvoiceType   @default(SIMPLIFIED) @map("invoice_type")
  placedAt        DateTime      @default(now()) @map("placed_at") @db.Timestamptz(3)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id])
  coupon          Coupon?          @relation(fields: [couponId], references: [id])
  subOrders       SubOrder[]
  payments        Payment[]
  invoices        TaxInvoice[]
  dealRedemptions DealRedemption[]

  @@index([userId, placedAt(sort: Desc)])
  @@index([status, placedAt])
  @@map("orders")
}

/// Values frozen at payment time (finance.md §6.2). vendorNet is NET of VAT.
model SubOrder {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                 String         @map("order_id") @db.Uuid
  /// D6: null = platform's own products
  vendorId                String?        @map("vendor_id") @db.Uuid
  /// SZ-100001-1
  number                  String         @unique
  status                  SubOrderStatus @default(PENDING_PAYMENT)
  priceSource             PriceSource    @default(REGULAR) @map("price_source")
  itemsGross              Int            @map("items_gross")
  subtotal                Int
  platformDiscountShare   Int            @default(0) @map("platform_discount_share")
  vendorDiscountShare     Int            @default(0) @map("vendor_discount_share")
  shippingFee             Int            @default(0) @map("shipping_fee")
  vatAmount               Int            @map("vat_amount")
  vatRateBp               Int            @map("vat_rate_bp")
  total                   Int
  commissionRate          Int            @default(0) @map("commission_rate")
  commissionBaseNet       Int            @default(0) @map("commission_base_net")
  commissionAmount        Int            @default(0) @map("commission_amount")
  feeBearer               FeeBearer      @default(PLATFORM) @map("fee_bearer")
  gatewayFeeShare         Int            @default(0) @map("gateway_fee_share")
  shippingMode            ShippingMode   @default(PLATFORM_SHIPPING) @map("shipping_mode")
  shippingNetToVendor     Int            @default(0) @map("shipping_net_to_vendor")
  vendorVatRegistered     Boolean        @default(false) @map("vendor_vat_registered")
  vendorVatNumberSnapshot String?        @map("vendor_vat_number_snapshot")
  vendorNet               Int            @default(0) @map("vendor_net")
  vendorVat               Int            @default(0) @map("vendor_vat")
  vendorPayable           Int            @default(0) @map("vendor_payable")
  shippedAt               DateTime?      @map("shipped_at") @db.Timestamptz(3)
  deliveredAt             DateTime?      @map("delivered_at") @db.Timestamptz(3)
  completedAt             DateTime?      @map("completed_at") @db.Timestamptz(3)
  cancelledAt             DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason            String?        @map("cancel_reason")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order               Order                @relation(fields: [orderId], references: [id])
  vendor              Vendor?              @relation(fields: [vendorId], references: [id])
  items               OrderItem[]
  history             OrderStatusHistory[]
  returns             Return[]
  shipments           Shipment[]
  walletTransactions  WalletTransaction[]
  paymentTransactions PaymentTransaction[]

  @@index([vendorId, status, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([status, deliveredAt])
  @@map("sub_orders")
}

model OrderItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subOrderId       String   @map("sub_order_id") @db.Uuid
  variantId        String?  @map("variant_id") @db.Uuid
  bundleId         String?  @map("bundle_id") @db.Uuid
  /// name, image, options, SKU at purchase time
  productSnapshot  Json     @map("product_snapshot")
  qty              Int
  unitPrice        Int      @map("unit_price")
  lineTotal        Int      @map("line_total")
  /// H12 / finance §7: per-line split (largest remainder)
  platformDiscount Int      @default(0) @map("platform_discount")
  vendorDiscount   Int      @default(0) @map("vendor_discount")
  netAmount        Int      @map("net_amount")
  vatAmount        Int      @map("vat_amount")
  vatRateBp        Int      @map("vat_rate_bp")
  priceLockId      String?  @map("price_lock_id") @db.Uuid
  dealId           String?  @map("deal_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subOrder  SubOrder        @relation(fields: [subOrderId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  bundle    Bundle?         @relation(fields: [bundleId], references: [id])
  priceLock PriceLock?      @relation(fields: [priceLockId], references: [id])
  deal      Deal?           @relation(fields: [dealId], references: [id])
  review    Review?
  invoiceLines TaxInvoiceLine[]

  @@index([subOrderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subOrderId String          @map("sub_order_id") @db.Uuid
  from       SubOrderStatus?
  to         SubOrderStatus
  byUserId   String?         @map("by_user_id") @db.Uuid
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  subOrder SubOrder @relation(fields: [subOrderId], references: [id])

  @@index([subOrderId, createdAt])
  @@map("order_status_history")
}

/// H14: 1:N with Order. id is our UUID and doubles as Moyasar given_id (6.2-10).
model Payment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  gateway        PaymentGateway
  method         PaymentMethod
  gatewayRef     String?        @map("gateway_ref")
  amount         Int
  currency       String         @default("SAR")
  fee            Int?
  feeNet         Int?           @map("fee_net")
  feeVat         Int?           @map("fee_vat")
  feeSource      FeeSource?     @map("fee_source")
  status         PaymentStatus  @default(INITIATED)
  rawPayload     Json?          @map("raw_payload")
  refundedAmount Int            @default(0) @map("refunded_amount")
  refundFeeNet   Int?           @map("refund_fee_net")
  authorizedAt   DateTime?      @map("authorized_at") @db.Timestamptz(3)
  paidAt         DateTime?      @map("paid_at") @db.Timestamptz(3)
  /// O3: money actually reached the owner's account
  settledAt      DateTime?      @map("settled_at") @db.Timestamptz(3)
  settlementRef  String?        @map("settlement_ref")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order        Order                @relation(fields: [orderId], references: [id])
  transactions PaymentTransaction[]

  @@unique([gateway, gatewayRef])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

/// C4: every authorize/capture/refund/void, idempotent.
model PaymentTransaction {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId         String                   @map("payment_id") @db.Uuid
  type              PaymentTransactionType
  amount            Int
  subOrderId        String?                  @map("sub_order_id") @db.Uuid
  returnId          String?                  @map("return_id") @db.Uuid
  gatewayRef        String?                  @map("gateway_ref")
  idempotencyKey    String                   @unique @map("idempotency_key")
  status            PaymentTransactionStatus @default(PENDING)
  method            PaymentTransactionMethod @default(GATEWAY)
  requestedByUserId String?                  @map("requested_by_user_id") @db.Uuid
  rawResponse       Json?                    @map("raw_response")
  error             String?
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment            Payment             @relation(fields: [paymentId], references: [id])
  subOrder           SubOrder?           @relation(fields: [subOrderId], references: [id])
  return             Return?             @relation(fields: [returnId], references: [id])
  walletTransactions WalletTransaction[]

  @@index([paymentId, type])
  @@map("payment_transactions")
}

/// C5: store first, answer 200, process in a job.
model WebhookEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider       WebhookProvider
  eventId        String          @map("event_id")
  type           String
  payload        Json
  signatureValid Boolean         @map("signature_valid")
  receivedAt     DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime?       @map("processed_at") @db.Timestamptz(3)
  attempts       Int             @default(0)
  lastError      String?         @map("last_error")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model Return {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subOrderId       String       @map("sub_order_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  /// [{ orderItemId, qty }]
  items            Json
  reason           String
  /// storage keys (private bucket)
  photos           String[]     @default([])
  status           ReturnStatus @default(REQUESTED)
  refundAmount     Int          @default(0) @map("refund_amount")
  decidedByUserId  String?      @map("decided_by_user_id") @db.Uuid
  decisionNote     String?      @map("decision_note")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  subOrder            SubOrder             @relation(fields: [subOrderId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  paymentTransactions PaymentTransaction[]
  walletTransactions  WalletTransaction[]
  invoices            TaxInvoice[]
  shipments           Shipment[]

  @@index([subOrderId])
  @@index([status, createdAt])
  @@map("returns")
}

model Review {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  /// must have bought it; one review per order line
  orderItemId String       @unique @map("order_item_id") @db.Uuid
  rating      Int
  comment     String?
  photos      String[]     @default([])
  status      ReviewStatus @default(PENDING)
  vendorReply String?      @map("vendor_reply")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([productId, status, createdAt(sort: Desc)])
  @@map("reviews")
}

/// D13 — foundation only: data model, sequential number, QR TLV structure. ZATCA phase 2 in P8.
/// Append-only (trigger): never updated or deleted; corrections = CREDIT_NOTE / DEBIT_NOTE.
/// Exception: zatca_status / zatca_response / xml_path may be filled once ZATCA is integrated (P8).
model TaxInvoice {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String         @map("order_id") @db.Uuid
  kind                TaxInvoiceKind @default(INVOICE)
  type                InvoiceType    @default(SIMPLIFIED)
  /// INV-2026-000001 style, from tax_invoice_number_seq (M1)
  number              String         @unique @default(dbgenerated("('INV-'::text || lpad(nextval('tax_invoice_number_seq'::regclass)::text, 8, '0'))"))
  uuid                String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Invoice Counter Value (ZATCA): strictly increasing per EGS
  icv                 BigInt         @unique @default(dbgenerated("nextval('tax_invoice_icv_seq'::regclass)"))
  previousInvoiceHash String?        @map("previous_invoice_hash")
  invoiceHash         String?        @map("invoice_hash")
  issuedAt            DateTime       @default(now()) @map("issued_at") @db.Timestamptz(3)
  sellerName          String         @map("seller_name")
  sellerVatNumber     String         @map("seller_vat_number")
  buyerName           String?        @map("buyer_name")
  buyerVatNumber      String?        @map("buyer_vat_number")
  netTotal            Int            @map("net_total")
  vatTotal            Int            @map("vat_total")
  grossTotal          Int            @map("gross_total")
  originalInvoiceId   String?        @map("original_invoice_id") @db.Uuid
  returnId            String?        @map("return_id") @db.Uuid
  reason              String?
  /// Base64 TLV (tags 1–5) — structure only until P8
  qrTlv               String         @map("qr_tlv")
  pdfPath             String?        @map("pdf_path")
  xmlPath             String?        @map("xml_path")
  zatcaStatus         ZatcaStatus    @default(PENDING) @map("zatca_status")
  zatcaResponse       Json?          @map("zatca_response")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  order           Order            @relation(fields: [orderId], references: [id])
  originalInvoice TaxInvoice?      @relation("InvoiceNotes", fields: [originalInvoiceId], references: [id])
  notes           TaxInvoice[]     @relation("InvoiceNotes")
  return          Return?          @relation(fields: [returnId], references: [id])
  lines           TaxInvoiceLine[]

  @@index([orderId])
  @@map("tax_invoices")
}

model TaxInvoiceLine {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId     String  @map("invoice_id") @db.Uuid
  orderItemId   String? @map("order_item_id") @db.Uuid
  lineNo        Int     @map("line_no")
  descriptionAr String  @map("description_ar")
  qty           Int
  /// gross unit price (VAT inclusive), halalas
  unitPrice     Int     @map("unit_price")
  discount      Int     @default(0)
  netAmount     Int     @map("net_amount")
  vatRateBp     Int     @map("vat_rate_bp")
  vatAmount     Int     @map("vat_amount")
  grossAmount   Int     @map("gross_amount")

  invoice   TaxInvoice @relation(fields: [invoiceId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@unique([invoiceId, lineNo])
  @@map("tax_invoice_lines")
}

// =====================================================================================
// 0004 — shipping (manual only, D17)
// =====================================================================================

model ShippingZone {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  baseFee          Int      @map("base_fee")
  perKgFee         Int      @default(0) @map("per_kg_fee")
  freeShippingOver Int?     @map("free_shipping_over")
  etaDays          Int      @map("eta_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cities ShippingZoneCity[]

  @@map("shipping_zones")
}

model ShippingZoneCity {
  zoneId String @map("zone_id") @db.Uuid
  cityId String @map("city_id") @db.Uuid

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  city City         @relation(fields: [cityId], references: [id])

  @@id([zoneId, cityId])
  @@index([cityId])
  @@map("shipping_zone_cities")
}

/// H3. provider = MANUAL only (D17): carrier name + tracking number typed by vendor/admin.
model Shipment {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subOrderId         String               @map("sub_order_id") @db.Uuid
  returnId           String?              @map("return_id") @db.Uuid
  direction          ShipmentDirection    @default(OUTBOUND)
  provider           ShippingProviderCode @default(MANUAL)
  carrier            String
  providerShipmentId String?              @map("provider_shipment_id")
  trackingNumber     String?              @map("tracking_number")
  labelPath          String?              @map("label_path")
  status             ShipmentStatus       @default(CREATED)
  cost               Int?
  declaredValue      Int?                 @map("declared_value")
  insuredAmount      Int?                 @map("insured_amount")
  /// no cash on delivery (O10)
  codAmount          Int                  @default(0) @map("cod_amount")
  createdByUserId    String?              @map("created_by_user_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  subOrder SubOrder        @relation(fields: [subOrderId], references: [id])
  return   Return?         @relation(fields: [returnId], references: [id])
  events   ShipmentEvent[]

  @@unique([provider, providerShipmentId])
  @@index([trackingNumber])
  @@index([subOrderId])
  @@map("shipments")
}

model ShipmentEvent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId      String         @map("shipment_id") @db.Uuid
  providerEventId String?        @unique @map("provider_event_id")
  status          ShipmentStatus
  note            String?
  occurredAt      DateTime       @map("occurred_at") @db.Timestamptz(3)
  raw             Json?
  byUserId        String?        @map("by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

// =====================================================================================
// 0005 — ledger, payouts, vendor purchase invoices
// =====================================================================================

model PayoutBatch {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodFrom      DateTime          @map("period_from") @db.Timestamptz(3)
  periodTo        DateTime          @map("period_to") @db.Timestamptz(3)
  cutoffAt        DateTime          @map("cutoff_at") @db.Timestamptz(3)
  totalAmount     Int               @default(0) @map("total_amount")
  heldVatAmount   Int               @default(0) @map("held_vat_amount")
  status          PayoutBatchStatus @default(DRAFT)
  exportFilePath  String?           @map("export_file_path")
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  payouts Payout[]

  @@map("payout_batches")
}

model Payout {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId          String       @map("vendor_id") @db.Uuid
  batchId           String?      @map("batch_id") @db.Uuid
  amount            Int
  heldVatAmount     Int          @default(0) @map("held_vat_amount")
  status            PayoutStatus @default(DRAFT)
  /// { iban(masked), bank, holder } at approval time
  bankSnapshot      Json         @map("bank_snapshot")
  cutoffAt          DateTime     @map("cutoff_at") @db.Timestamptz(3)
  /// O3: manual review flag for payouts >= 10,000 SAR
  needsManualReview Boolean      @default(false) @map("needs_manual_review")
  transferReference String?      @map("transfer_reference")
  receiptPath       String?      @map("receipt_path")
  approvedByUserId  String?      @map("approved_by_user_id") @db.Uuid
  approvedAt        DateTime?    @map("approved_at") @db.Timestamptz(3)
  paidAt            DateTime?    @map("paid_at") @db.Timestamptz(3)
  paidByUserId      String?      @map("paid_by_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor             Vendor                  @relation(fields: [vendorId], references: [id])
  batch              PayoutBatch?            @relation(fields: [batchId], references: [id])
  walletTransactions WalletTransaction[]
  purchaseInvoices   VendorPurchaseInvoice[]

  @@index([vendorId, status])
  @@index([batchId])
  @@map("payouts")
}

/// C7 / finance.md 6.3: append-only ledger; only status/hold fields may move forward (trigger).
model WalletTransaction {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId              String                  @map("vendor_id") @db.Uuid
  subOrderId            String?                 @map("sub_order_id") @db.Uuid
  payoutId              String?                 @map("payout_id") @db.Uuid
  returnId              String?                 @map("return_id") @db.Uuid
  paymentTransactionId  String?                 @map("payment_transaction_id") @db.Uuid
  reversesTransactionId String?                 @map("reverses_transaction_id") @db.Uuid
  type                  WalletTransactionType
  /// signed halalas; sign must match the type (CHECK)
  amount                Int
  status                WalletTransactionStatus @default(PENDING)
  holdReason            HoldReason?             @map("hold_reason")
  availableAt           DateTime?               @map("available_at") @db.Timestamptz(3)
  note                  String?
  createdByUserId       String?                 @map("created_by_user_id") @db.Uuid
  /// sale:{subOrderId}, commission:{subOrderId}, refund:{paymentTransactionId}, ...
  idempotencyKey        String                  @unique @map("idempotency_key")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor             Vendor              @relation(fields: [vendorId], references: [id])
  subOrder           SubOrder?           @relation(fields: [subOrderId], references: [id])
  payout             Payout?             @relation(fields: [payoutId], references: [id])
  return             Return?             @relation(fields: [returnId], references: [id])
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  reverses           WalletTransaction?  @relation("WalletReversal", fields: [reversesTransactionId], references: [id])
  reversedBy         WalletTransaction[] @relation("WalletReversal")

  @@index([vendorId, status, availableAt])
  @@index([payoutId])
  @@index([subOrderId])
  @@map("wallet_transactions")
}

/// D11 / O2-A1: registered vendors invoice the platform; VAT part held until MATCHED.
model VendorPurchaseInvoice {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId            String                      @map("vendor_id") @db.Uuid
  payoutId            String?                     @map("payout_id") @db.Uuid
  periodFrom          DateTime                    @map("period_from") @db.Timestamptz(3)
  periodTo            DateTime                    @map("period_to") @db.Timestamptz(3)
  vendorInvoiceNumber String?                     @map("vendor_invoice_number")
  issueDate           DateTime?                   @map("issue_date") @db.Timestamptz(3)
  netAmount           Int                         @map("net_amount")
  vatAmount           Int                         @map("vat_amount")
  /// private bucket key
  filePath            String?                     @map("file_path")
  status              VendorPurchaseInvoiceStatus @default(EXPECTED)
  matchedByUserId     String?                     @map("matched_by_user_id") @db.Uuid
  matchedAt           DateTime?                   @map("matched_at") @db.Timestamptz(3)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor Vendor  @relation(fields: [vendorId], references: [id])
  payout Payout? @relation(fields: [payoutId], references: [id])

  @@index([vendorId, status])
  @@map("vendor_purchase_invoices")
}

// =====================================================================================
// 0006 — price history (H5, written by trigger)
// =====================================================================================

model PriceHistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  price           Int
  compareAtPrice  Int?     @map("compare_at_price")
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, changedAt(sort: Desc)])
  @@map("price_history")
}

// =====================================================================================
// 0007 — deals (H6, H7, M12, M13, D16)
// =====================================================================================

model Deal {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId              String?    @map("vendor_id") @db.Uuid
  /// exactly one of productId / bundleId (CHECK, M12)
  productId             String?    @map("product_id") @db.Uuid
  bundleId              String?    @map("bundle_id") @db.Uuid
  type                  DealType
  /// exactly one of dealPrice / discountBps (CHECK, M13)
  dealPrice             Int?       @map("deal_price")
  discountBps           Int?       @map("discount_bps")
  startsAt              DateTime   @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime   @map("ends_at") @db.Timestamptz(3)
  stockLimit            Int?       @map("stock_limit")
  soldCount             Int        @default(0) @map("sold_count")
  /// H7: quota held by PENDING_PAYMENT orders
  reservedCount         Int        @default(0) @map("reserved_count")
  perCustomerLimit      Int?       @map("per_customer_limit")
  titleAr               String     @map("title_ar")
  titleEn               String     @map("title_en")
  badgeAr               String?    @map("badge_ar")
  badgeEn               String?    @map("badge_en")
  status                DealStatus @default(DRAFT)
  rejectReason          String?    @map("reject_reason")
  isPinned              Boolean    @default(false) @map("is_pinned")
  priority              Int        @default(0)
  /// D16: used only when souqDiscountsRequireLicense = true
  discountLicenseNumber String?    @map("discount_license_number")
  discountLicenseFrom   DateTime?  @map("discount_license_from") @db.Timestamptz(3)
  discountLicenseTo     DateTime?  @map("discount_license_to") @db.Timestamptz(3)
  approvedByUserId      String?    @map("approved_by_user_id") @db.Uuid
  approvedAt            DateTime?  @map("approved_at") @db.Timestamptz(3)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor      Vendor?          @relation(fields: [vendorId], references: [id])
  product     Product?         @relation(fields: [productId], references: [id])
  bundle      Bundle?          @relation(fields: [bundleId], references: [id])
  variants    DealVariant[]
  redemptions DealRedemption[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([status, startsAt, endsAt])
  @@index([vendorId, status])
  @@index([isPinned, priority])
  @@map("deals")
}

/// H6: one active deal per variant at a time — exclusion constraint on (variant_id, tstzrange) WHERE is_blocking.
model DealVariant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId     String   @map("deal_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  /// true while the deal is PENDING / APPROVED / LIVE
  isBlocking Boolean  @default(true) @map("is_blocking")

  deal    Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([dealId, variantId])
  @@index([variantId])
  @@map("deal_variants")
}

/// H7: perCustomerLimit under concurrency (advisory lock on deal+user).
model DealRedemption {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId    String               @map("deal_id") @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  orderId   String?              @map("order_id") @db.Uuid
  qty       Int
  status    DealRedemptionStatus @default(RESERVED)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  deal  Deal   @relation(fields: [dealId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([dealId, userId, status])
  @@map("deal_redemptions")
}

// =====================================================================================
// 0008 — negotiation (C6, H9, H10, H11, M7, M8, M9, D22)
// =====================================================================================

/// General per-product settings (C6). Secrets live per variant in VariantNegotiationSettings.
model NegotiationSettings {
  productId           String   @id @map("product_id") @db.Uuid
  allowBargain        Boolean  @default(false) @map("allow_bargain")
  maxRounds           Int      @default(3) @map("max_rounds")
  responseWindowHours Int      @default(24) @map("response_window_hours")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("negotiation_settings")
}

/// SECRET (D23): never leaves the server except to the owning vendor. Omitted globally; RLS has no customer policy.
model VariantNegotiationSettings {
  variantId       String   @id @map("variant_id") @db.Uuid
  floorPrice      Int      @map("floor_price")
  autoAcceptPrice Int?     @map("auto_accept_price")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_negotiation_settings")
}

model PriceRequest {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// PR-10001 from a SEQUENCE (M1)
  number          String             @unique @default(dbgenerated("('PR-'::text || nextval('price_request_number_seq'::regclass))"))
  customerId      String             @map("customer_id") @db.Uuid
  type            PriceRequestType
  productId       String?            @map("product_id") @db.Uuid
  variantId       String?            @map("variant_id") @db.Uuid
  categoryId      String             @map("category_id") @db.Uuid
  titleAr         String             @map("title_ar")
  description     String?
  images          String[]           @default([])
  qty             Int
  /// per unit, halalas
  targetPrice     Int                @map("target_price")
  cityId          String             @map("city_id") @db.Uuid
  status          PriceRequestStatus @default(OPEN)
  expiresAt       DateTime           @map("expires_at") @db.Timestamptz(3)
  acceptedOfferId String?            @unique @map("accepted_offer_id") @db.Uuid
  broadcastCount  Int                @default(0) @map("broadcast_count")
  viewsCount      Int                @default(0) @map("views_count")
  /// admin moderation (SPEC 6.8)
  hiddenAt        DateTime?          @map("hidden_at") @db.Timestamptz(3)
  hiddenReason    String?            @map("hidden_reason")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer   User                    @relation(fields: [customerId], references: [id])
  product    Product?                @relation(fields: [productId], references: [id])
  variant    ProductVariant?         @relation(fields: [variantId], references: [id])
  category   Category                @relation(fields: [categoryId], references: [id])
  city       City                    @relation(fields: [cityId], references: [id])
  recipients PriceRequestRecipient[]
  threads    NegotiationThread[]
  offers     PriceOffer[]

  @@index([status, expiresAt])
  @@index([customerId, status])
  @@index([categoryId, status, createdAt(sort: Desc)])
  @@map("price_requests")
}

model PriceRequestRecipient {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String          @map("request_id") @db.Uuid
  /// null = the platform (D6) for its own product
  vendorId    String?         @map("vendor_id") @db.Uuid
  status      RecipientStatus @default(SENT)
  seenAt      DateTime?       @map("seen_at") @db.Timestamptz(3)
  respondedAt DateTime?       @map("responded_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  request PriceRequest @relation(fields: [requestId], references: [id])
  vendor  Vendor?      @relation(fields: [vendorId], references: [id])

  @@unique([requestId, vendorId])
  @@index([vendorId, status, createdAt(sort: Desc)])
  @@map("price_request_recipients")
}

/// H9: one thread per (request, vendor); vendor queries always start here.
model NegotiationThread {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId      String       @map("request_id") @db.Uuid
  vendorId       String?      @map("vendor_id") @db.Uuid
  productId      String?      @map("product_id") @db.Uuid
  variantId      String?      @map("variant_id") @db.Uuid
  vendorRounds   Int          @default(0) @map("vendor_rounds")
  customerRounds Int          @default(0) @map("customer_rounds")
  status         ThreadStatus @default(OPEN)
  lastOfferId    String?      @map("last_offer_id") @db.Uuid
  version        Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  request PriceRequest    @relation(fields: [requestId], references: [id])
  vendor  Vendor?         @relation(fields: [vendorId], references: [id])
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  offers  PriceOffer[]

  @@unique([requestId, vendorId])
  @@index([vendorId, status])
  @@map("negotiation_threads")
}

model PriceOffer {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId     String      @map("request_id") @db.Uuid
  threadId      String      @map("thread_id") @db.Uuid
  vendorId      String?     @map("vendor_id") @db.Uuid
  productId     String      @map("product_id") @db.Uuid
  variantId     String      @map("variant_id") @db.Uuid
  round         Int
  parentOfferId String?     @map("parent_offer_id") @db.Uuid
  author        OfferAuthor
  unitPrice     Int         @map("unit_price")
  qty           Int
  shippingFee   Int         @default(0) @map("shipping_fee")
  etaDays       Int         @map("eta_days")
  /// M8: raw text for admins only; customers/vendors see noteSanitized
  noteRaw       String?     @map("note_raw")
  noteSanitized String?     @map("note_sanitized")
  status        OfferStatus @default(PENDING)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  isAuto        Boolean     @default(false) @map("is_auto")
  /// D22: auto-accept becomes visible after a random 2–10 min delay
  visibleAt     DateTime?   @map("visible_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  request   PriceRequest      @relation(fields: [requestId], references: [id])
  thread    NegotiationThread @relation(fields: [threadId], references: [id])
  vendor    Vendor?           @relation(fields: [vendorId], references: [id])
  product   Product           @relation(fields: [productId], references: [id])
  variant   ProductVariant    @relation(fields: [variantId], references: [id])
  parent    PriceOffer?       @relation("OfferChain", fields: [parentOfferId], references: [id])
  children  PriceOffer[]      @relation("OfferChain")
  priceLock PriceLock?

  @@index([threadId, createdAt])
  @@index([status, expiresAt])
  @@map("price_offers")
}

/// H11: IN_CHECKOUT + pendingOrderId so the expiry cron never frees stock under a paying customer.
model PriceLock {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId        String          @unique @map("offer_id") @db.Uuid
  customerId     String          @map("customer_id") @db.Uuid
  variantId      String          @map("variant_id") @db.Uuid
  unitPrice      Int             @map("unit_price")
  qty            Int
  /// M7 / D23: overrides the zone shipping for this line
  shippingFee    Int             @default(0) @map("shipping_fee")
  expiresAt      DateTime        @map("expires_at") @db.Timestamptz(3)
  reservationId  String?         @map("reservation_id") @db.Uuid
  status         PriceLockStatus @default(ACTIVE)
  pendingOrderId String?         @map("pending_order_id") @db.Uuid
  usedOrderId    String?         @map("used_order_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  offer      PriceOffer     @relation(fields: [offerId], references: [id])
  customer   User           @relation(fields: [customerId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  cartItem   CartItem?
  orderItems OrderItem[]

  @@index([status, expiresAt])
  @@index([customerId, status])
  @@map("price_locks")
}

/// M8 / D22: each contact-sharing attempt; 3 in 7 days suspends bargaining for 7 days.
model ModerationFlag {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType   ModerationActorType @map("actor_type")
  actorUserId String              @map("actor_user_id") @db.Uuid
  vendorId    String?             @map("vendor_id") @db.Uuid
  entity      String
  entityId    String?             @map("entity_id")
  /// PHONE | EMAIL | URL | HANDLE | WHATSAPP | TELEGRAM (from lib/contact-filter)
  reasons     String[]
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([vendorId, createdAt(sort: Desc)])
  @@map("moderation_flags")
}

// =====================================================================================
// 0010 — realtime outbox (P1-00, SPEC §5.1). The app role has NO direct access.
// =====================================================================================

model RealtimeEvent {
  id        BigInt   @id @default(autoincrement())
  topic     String
  type      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([topic, id])
  @@index([createdAt])
  @@map("realtime_events")
}
