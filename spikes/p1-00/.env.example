# P1-00 spike — local only. Copy to .env. No real secrets here.
# Superuser URL, used ONLY by scripts/bootstrap-db.ts to create roles + database.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres
# Owner role: runs migrations (Prisma CLI reads DATABASE_URL via prisma.config.ts).
DATABASE_URL=postgresql://suq_owner:owner_dev_pw@127.0.0.1:55432/suq_spike
# Runtime role used by the app: NOSUPERUSER NOBYPASSRLS, not table owner -> RLS applies.
APP_DATABASE_URL=postgresql://suq_app:app_dev_pw@127.0.0.1:55432/suq_spike
APP_DB_POOL_MAX=60
# HMAC secret that stands in for Better Auth server sessions in the spike.
SPIKE_SESSION_SECRET=change-me-dev-only
# SSE heartbeat interval (ms)
SSE_HEARTBEAT_MS=25000
