# =============================================================================
# Souq AlZal — environment variables (template). SPEC §9: secrets live in .env
# only; this file is the documented list and MUST be updated with every new var.
#
#   cp .env.example .env        (or: bash scripts/dev-setup.sh — it also fills
#                                 the "generated" secrets below with random values)
#
# Rules
# - No real value is ever written here. Empty = feature off / console driver.
# - Values marked "dev-only" are safe defaults for the local Docker stack, which
#   binds to 127.0.0.1 only. Never reuse them anywhere else.
# - Live payment/SMS/WhatsApp keys exist only in production (P8, D14). Every other
#   environment uses sandbox/test keys or the console driver.
# - Business settings (VAT 1500 bps, commission, holdDays, payout cycle, O1/O3/O7,
#   D22 negotiation limits, souqDiscountsRequireLicense...) are NOT env vars:
#   they live in the `Setting` table and are seeded by prisma/seed.ts (P1-01).
# - NEXT_PUBLIC_* values are embedded in the browser bundle: never put a secret there.
# - Docker Compose reads this same file for its ${VAR} defaults (docker-compose.yml).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. App
# -----------------------------------------------------------------------------
# development | test | production (Node/Next.js semantics; set by the tooling).
NODE_ENV=development
# Our deployment label: development | test | staging | production. Used in logs,
# Sentry environment, and Moyasar `metadata.env` (SPEC 6.2-10). Live payment keys
# must be rejected unless APP_ENV=production.
APP_ENV=development
# Public base URL of the site (no trailing slash). Used for absolute links in
# SMS/email (SPEC §8: full https links in production), callbacks and CORS.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Host port the app listens on (compose `app` service / `npm run dev`).
APP_PORT=3000
# Server and database run in UTC; the UI displays Asia/Riyadh (SPEC §2).
TZ=UTC
# debug | info | warn | error. Logs are structured JSON with requestId, no PII.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# 2. Database — PostgreSQL 16 (docker compose `postgres`)
# Two roles (docker/postgres/init/10-roles-databases-extensions.sh):
#   app role      -> DATABASE_URL : DML only, not owner, RLS applies.
#   migrator role -> DIRECT_URL   : owns the schema, runs prisma migrate.
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_DB=suqalzl
POSTGRES_TEST_DB=suqalzl_test
# Superuser of the local container. Used only by the init script and dev backups.
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
DB_APP_USER=suqalzl_app
DB_APP_PASSWORD=suqalzl_app_dev_only
DB_MIGRATOR_USER=suqalzl_migrator
DB_MIGRATOR_PASSWORD=suqalzl_migrator_dev_only
# Keep the URLs in sync with the users/passwords/port above (they are literal on
# purpose: not every tool expands ${VAR} inside .env files).
DATABASE_URL=postgresql://suqalzl_app:suqalzl_app_dev_only@localhost:5432/suqalzl
DIRECT_URL=postgresql://suqalzl_migrator:suqalzl_migrator_dev_only@localhost:5432/suqalzl
# Vitest / Playwright database (wiped by the tests, never point it at real data).
TEST_DATABASE_URL=postgresql://suqalzl_app:suqalzl_app_dev_only@localhost:5432/suqalzl_test
TEST_DIRECT_URL=postgresql://suqalzl_migrator:suqalzl_migrator_dev_only@localhost:5432/suqalzl_test
# Connection pool per app instance. Budget: instances x DB_POOL_MAX + jobs must stay
# under 80% of max_connections (devops.md §6.4).
DB_POOL_MAX=5
DB_POOL_TIMEOUT_MS=10000
# Dedicated, NON-pooled connection for Realtime LISTEN/NOTIFY (library `pg`).
# Empty = use DATABASE_URL. Must never go through a transaction-mode pooler.
REALTIME_DATABASE_URL=

# -----------------------------------------------------------------------------
# 3. Object storage — S3-compatible (StorageProvider). Dev: SeaweedFS in compose.
# -----------------------------------------------------------------------------
# s3 (any S3-compatible service). Other drivers may be added behind the interface.
STORAGE_PROVIDER=s3
# Endpoint the SERVER uses to reach storage.
S3_ENDPOINT=http://localhost:8333
# Endpoint the BROWSER uses: base for public image URLs and the host presigned URLs
# are signed for. Equal to S3_ENDPOINT on the host; differs inside Docker.
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_PORT=8333
# Any value works for SeaweedFS; AWS SDKs require one.
S3_REGION=us-east-1
# Path-style URLs (http://host/bucket/key). Required for SeaweedFS/most local servers.
S3_FORCE_PATH_STYLE=true
# dev-only credentials of the local storage admin (compose passes them to SeaweedFS).
S3_ACCESS_KEY_ID=suqalzl-dev-access
S3_SECRET_ACCESS_KEY=suqalzl-dev-secret-change-me
# Public bucket: product images (anonymous read). Private bucket: vendor documents,
# IBAN letters (presigned URLs only, SPEC §9). Dev names are fixed (docker/seaweedfs/s3.json).
S3_BUCKET_PUBLIC=suqalzl-public
S3_BUCKET_PRIVATE=suqalzl-private
# Lifetime of presigned URLs for private documents.
S3_SIGNED_URL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# 4. Auth (Better Auth or Auth.js — chosen in P1-01)
# -----------------------------------------------------------------------------
# generated: 32+ random bytes, base64. Session/cookie signing. Rotate every 6 months.
AUTH_SECRET=
# Base URL the auth library uses for callbacks (= APP_URL).
AUTH_URL=http://localhost:3000
# generated: HMAC key for storing OTP codes as hashes (SPEC §9: hash only, 6 digits,
# 5 minutes, 5 attempts). Separate from AUTH_SECRET.
OTP_HMAC_SECRET=
# First SUPER_ADMIN, created by prisma/seed.ts only (SPEC P1-01). Phone format +9665XXXXXXXX.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PHONE=
# generated in dev by dev-setup.sh. In any shared environment set it by hand, then
# change it at first login.
SUPER_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 5. Field encryption (IBAN, sensitive vendor documents) — SPEC §9, devops.md §6.2
# Separate from every other key. Versioned so it can be rotated.
# -----------------------------------------------------------------------------
# generated: 32 random bytes, base64 (AES-256-GCM key).
FIELD_ENCRYPTION_KEY=
# Version tag stored next to each ciphertext.
FIELD_ENCRYPTION_KEY_ID=v1
# Old keys still allowed for DECRYPT during rotation: "v0:<base64>,..." Empty normally.
FIELD_ENCRYPTION_PREVIOUS_KEYS=

# -----------------------------------------------------------------------------
# 6. Background jobs (JobScheduler) — POST /api/cron/<job> (devops.md §6.5)
# -----------------------------------------------------------------------------
# local = dev trigger (scripts/dev-cron.mjs); http = external scheduler (P7).
JOB_SCHEDULER=local
# generated: bearer token the cron trigger sends. (Cloud Scheduler would use OIDC.)
CRON_SECRET=
# Comma-separated job slugs the local trigger calls (defined by backend in P5-03).
# Empty = the trigger idles.
DEV_CRON_JOBS=
DEV_CRON_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# 7. Realtime (RealtimeProvider) — phase 1: SSE + Postgres LISTEN/NOTIFY
# -----------------------------------------------------------------------------
# sse (phase 1). centrifugo later if load requires it (devops.md §5.2).
REALTIME_PROVIDER=sse
# SSE keep-alive comment interval; keeps proxies from closing idle streams.
REALTIME_HEARTBEAT_SECONDS=25

# -----------------------------------------------------------------------------
# 8. Payments — SANDBOX ONLY until P8 (D14). PaymentProvider.
# -----------------------------------------------------------------------------
# sandbox | live. The app must refuse `live` unless APP_ENV=production, and refuse
# test keys when live.
PAYMENTS_MODE=sandbox

# Moyasar (mada, Visa, Mastercard, Apple Pay, STC Pay). Dashboard > Settings > API Keys.
MOYASAR_API_BASE_URL=https://api.moyasar.com/v1
# pk_test_... (browser form, safe to expose).
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
# sk_test_... server only. Used to create/fetch/refund payments and to RE-FETCH every
# webhook payment (backend.md §3: the webhook has no HMAC signature).
MOYASAR_SECRET_KEY=
# The `secret_token` we choose when registering the webhook; compared in constant time.
MOYASAR_WEBHOOK_SECRET=

# Tabby (BNPL, Saudi API api.tabby.sa).
TABBY_API_BASE_URL=https://api.tabby.sa
# pk_test_... (checkout widget).
NEXT_PUBLIC_TABBY_PUBLIC_KEY=
# sk_test_... server only.
TABBY_SECRET_KEY=
# Merchant code given by Tabby for the Saudi store.
TABBY_MERCHANT_CODE=
# Tabby webhooks are authenticated by a header WE define (name + value), not a signature.
TABBY_WEBHOOK_HEADER_NAME=X-Webhook-Token
TABBY_WEBHOOK_SECRET=

# Tamara (BNPL). Sandbox base URL; production is https://api.tamara.co (P8 only).
TAMARA_API_BASE_URL=https://api-sandbox.tamara.co
# API token from the Tamara partner portal (server only).
TAMARA_API_TOKEN=
# Notification token: verifies webhook JWT (HS256) in `tamaraToken` / Authorization.
TAMARA_NOTIFICATION_TOKEN=
# Public key for the Tamara widget (browser).
NEXT_PUBLIC_TAMARA_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# 9. SMS + OTP — Taqnyat behind SmsProvider (D20). OTP is generated by us.
# -----------------------------------------------------------------------------
# console = print the message/OTP in the server log (default in dev, SPEC §2).
# taqnyat | unifonic = real sending (needs approved sender and templates, P8).
SMS_PROVIDER=console
TAQNYAT_API_BASE_URL=https://api.taqnyat.sa
# Bearer token from the Taqnyat developer dashboard.
TAQNYAT_API_KEY=
# Registered sender name (D20). Registration is a P8 task.
TAQNYAT_SENDER_NAME=SuqAlZal
# Shared token we put in the delivery-report webhook URL/header (Taqnyat signing
# method needs confirmation from the provider, backend.md §2).
TAQNYAT_WEBHOOK_SECRET=
# Unifonic = fallback behind the same interface (only if SMS_PROVIDER=unifonic).
UNIFONIC_APP_SID=
UNIFONIC_SENDER_NAME=

# -----------------------------------------------------------------------------
# 10. WhatsApp — Meta Cloud API behind WhatsAppProvider (D20)
# -----------------------------------------------------------------------------
# console | meta
WHATSAPP_PROVIDER=console
# Graph API version pinned by backend in P5-02 (e.g. vNN.0).
META_GRAPH_API_VERSION=
# System-user access token (server only).
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# App secret: verifies X-Hub-Signature-256 on incoming webhooks.
META_WHATSAPP_APP_SECRET=
# Token we choose; Meta echoes it in the hub.verify_token handshake.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# 11. Email — Resend + react-email (EmailProvider)
# -----------------------------------------------------------------------------
# smtp = send to Mailpit in dev (http://localhost:8025) | resend | console
EMAIL_PROVIDER=smtp
# Sender. In production: a verified Resend domain (P8).
EMAIL_FROM="Souq AlZal <no-reply@example.com>"
EMAIL_REPLY_TO=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# re_... server only (EMAIL_PROVIDER=resend).
RESEND_API_KEY=
# Optional: signing secret of the Resend webhook (bounces/complaints).
RESEND_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 12. Error monitoring — Sentry, PII scrubbing mandatory (SPEC §2, devops.md §6.4)
# Empty DSN = Sentry disabled (default in dev). sendDefaultPii=false and beforeSend
# strips phone/email/address/IBAN regardless of these values.
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to APP_ENV when empty.
SENTRY_ENVIRONMENT=
# 0..1. Keep 0 in dev.
SENTRY_TRACES_SAMPLE_RATE=0
# CI only (source map upload). Never on app servers.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# 13. Analytics — loaded ONLY after cookie consent (PDPL, P5-04). Empty = off.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side Meta Conversions API token (server only).
META_CAPI_ACCESS_TOKEN=
NEXT_PUBLIC_SNAP_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# -----------------------------------------------------------------------------
# 14. Tests
# -----------------------------------------------------------------------------
# Playwright base URL (its webServer starts the app when nothing is listening).
PLAYWRIGHT_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 15. Local backups (scripts/dev-db-backup.sh) — dev only
# Production backups (age-encrypted, off-site, PITR) are a P7-02 task; their public
# key variable BACKUP_ENCRYPTION_PUBLIC_KEY is added then.
# -----------------------------------------------------------------------------
DEV_BACKUP_DIR=./backups
DEV_BACKUP_KEEP=10
