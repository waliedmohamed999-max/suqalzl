// Souq AlZal — Prisma schema (SPEC §5 + §5.1, docs/decisions/backend.md §5, docs/decisions/finance.md §7).
// Owner: backend-engineer only (CLAUDE.md rule 4).
//
// Conventions
// - Money = Int halalas (D7). Rates = Int basis points (1000 = 10%). Never Float.
// - Timestamps = timestamptz(3), UTC (SPEC §2). IDs = gen_random_uuid() in the database.
// - Tables/columns snake_case via @@map/@map so RLS policies and raw SQL stay readable.
// - "Actor" columns (createdByUserId, approvedByUserId, ...) are plain UUIDs without FK on purpose:
//   users are anonymised, never deleted (M10), and keeping them out of Prisma relations keeps
//   the User model readable. Integrity of business relations is enforced with real FKs.
// - Objects Prisma cannot express (CHECKs, partial/unique-where indexes, exclusion constraints,
//   triggers, RLS, sequences) live in the migration SQL (prisma/sql/*.sql). If `prisma migrate dev`
//   is ever run, remove the DROP statements it generates for them (docs/runbooks/db-migrations.md).
// - Secrets are omitted globally in src/lib/db.ts (backend.md 5.6-1): VariantNegotiationSettings
//   floorPrice/autoAcceptPrice, User.passwordHash, Vendor.iban (ciphertext).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

